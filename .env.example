# copy this file to .env and fill in your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# run `python week1_foundations/examples/hello_gemini.py` to list the models your key can use
GEMINI_MODEL=gemini-3.1-flash-lite
# seconds in one tutor "day". 86400 = real days; 60 = one minute (great for demos)
REMIND_DAY_SECONDS=60
